# Auth token for API access. If not set, a random token is generated at startup.
AUTH_TOKEN=your-secret-token-here

# Base URL for QR code (e.g., http://192.168.1.100:8787).
# If not set, the server auto-detects from network interfaces.
# In WSL2, auto-detection may return an internal IP. Set this to your Windows host's LAN IP.
HOST_URL=

# Path to claude command. If not set, uses 'claude' from PATH.
# CLAUDE_PATH=/home/user/.local/bin/claude

PORT=8787
DB_PATH=./data/sessions.db

# SSL/TLS (optional). Set both to enable HTTPS.
# Supports Let's Encrypt, Tailscale cert, or self-signed certificates.
# SSL_CERT_PATH=./certs/fullchain.pem
# SSL_KEY_PATH=./certs/privkey.pem
